{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pra-v4-deep-reading-pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "language", "note_sections", "structure", "formulas", "figures", "coverage", "claims", "parameters"],
  "properties": {
    "schema_version": {"const": 4},
    "paper_id": {"type": "string", "minLength": 1},
    "language": {"const": "zh-CN"},
    "note_sections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "structure": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "formulas": {"type": "array", "items": {"type": "object"}},
    "figures": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "claims": {"type": "array", "items": {"type": "object"}},
    "parameters": {"type": "array", "items": {"type": "object"}}
  }
}
