{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pra-v4-target-matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "round", "targets"],
  "properties": {
    "schema_version": {"const": 4},
    "case_id": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "claim_id", "claim", "paper_anchors", "route", "run_state", "claim_status", "comparison_verdict", "acceptance", "evidence_plan"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "paper_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "route": {"enum": ["official_artifact_replay", "independent_reimplementation", "figure_digitization", "visual_reconstruction", "not_applicable_schematic"]},
          "run_state": {"enum": ["not_started", "preview_ready", "approved", "running", "completed", "failed", "blocked"]},
          "claim_status": {"enum": ["NOT_ATTEMPTED", "REPRODUCED_WITHIN_ACCEPTANCE", "NOT_REPRODUCED", "INCONCLUSIVE", "BLOCKED", "MANUAL_REVIEW_REQUIRED"]},
          "comparison_verdict": {"enum": ["not_evaluated", "within_acceptance", "feature_level_consistent", "scale_offset_but_trend_consistent", "trend_mismatch", "key_feature_mismatch", "blocked_unreadable_anchor", "blocked_missing_candidate", "not_applicable_schematic", "manual_review_required"]},
          "acceptance": {"type": "object"},
          "evidence_plan": {"type": "string", "minLength": 1},
          "approval": {"type": ["string", "null"]},
          "reference_anchor_mode": {"enum": ["author_raw_data", "author_generated_data", "supplementary_data", "pdf_digitized_coordinates", "paper_table_values", "screenshot_coarse_anchor", "visual_description_only", "not_applicable_schematic", "blocked_unreadable_anchor"]},
          "paper_anchor_plan": {"type": "string"}
        }
      }
    }
  }
}
