{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pra-v4-evidence-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "target_id", "claim", "source", "inputs", "command", "capabilities", "budget", "outputs", "observation", "comparison"],
  "properties": {
    "schema_version": {"const": 4},
    "plan_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "paper_anchors", "route"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "paper_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "route": {"enum": ["official_artifact_replay", "independent_reimplementation", "figure_digitization", "visual_reconstruction", "not_applicable_schematic"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "commit", "tree_hash", "dirty_diff_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": ["string", "null"]},
        "tree_hash": {"type": "string", "minLength": 1},
        "dirty_diff_sha256": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "environment": {"type": "object"}
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["network", "read_paths", "write_paths", "code_trust", "external_sandbox", "untrusted_materials"],
      "properties": {
        "network": {"enum": ["forbidden", "required"]},
        "read_paths": {"type": "array", "items": {"type": "string"}},
        "write_paths": {"type": "array", "items": {"type": "string"}},
        "code_trust": {"enum": ["reviewed", "unknown", "suspected_malicious"]},
        "external_sandbox": {"type": "boolean"},
        "untrusted_materials": {"type": "array", "items": {"type": "string"}}
      }
    },
    "budget": {
      "type": "object",
      "required": ["wall_time_seconds", "disk_mb", "output_count", "single_file_mb", "memory_mb", "gpu"],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0.1},
        "disk_mb": {"type": "number", "minimum": 0},
        "output_count": {"type": "integer", "minimum": 0},
        "single_file_mb": {"type": "number", "minimum": 0},
        "memory_mb": {"type": "object"},
        "gpu": {"type": "object"}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"type": "string"}}
      }
    },
    "observation": {
      "type": "object",
      "required": ["method", "artifact", "selector", "unit", "bound_to_run"],
      "properties": {
        "method": {"enum": ["json_path", "csv_table", "regex_stdout", "file_sha256", "literal", "manual"]},
        "artifact": {"type": ["string", "null"]},
        "selector": {},
        "unit": {"type": ["string", "null"]},
        "bound_to_run": {"type": "boolean"}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["type", "reference", "acceptance", "evidence_strength", "unit_conversion"],
      "properties": {
        "type": {"enum": ["scalar", "string", "category", "set", "vector", "matrix", "table", "curve", "stochastic", "file", "visual", "manual"]},
        "reference": {},
        "acceptance": {"type": "object"},
        "evidence_strength": {"enum": ["numeric", "digitized_numeric", "screenshot_coarse_anchor", "visual_only", "manual"]},
        "unit_conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "offset"],
          "properties": {"scale": {"type": "number"}, "offset": {"type": "number"}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
